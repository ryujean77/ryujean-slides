<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitNotion CMS - GitHub 기반 노션형 퍼블리싱 & 업무관리 대시보드</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Pretendard Font -->
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.8/dist/web/static/pretendard.css" />
    <!-- Vue 3 CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Pretendard', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'sans-serif'],
                        mono: ['JetBrains Mono', 'Fira Code', 'Consolas', 'monospace']
                    },
                    colors: {
                        notion: {
                            bg: '#ffffff',
                            sidebar: '#fbfbfa',
                            card: '#ffffff',
                            border: '#e9e9e7',
                            hover: '#efefee',
                            text: '#37352f',
                            muted: '#787774',
                            blue: '#0b6e99',
                            green: '#0f7b6c',
                            orange: '#d9730d',
                            purple: '#6940a5',
                            pink: '#ad1a72'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Pretendard', sans-serif; color: #37352f; }
        [v-cloak] { display: none; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #d3d3d1; border-radius: 9999px; }
        .notion-card {
            box-shadow: 0 1px 3px rgba(15, 15, 15, 0.05), 0 0 0 1px rgba(15, 15, 15, 0.08);
            transition: all 0.2s ease;
        }
        .notion-card:hover {
            box-shadow: 0 4px 12px rgba(15, 15, 15, 0.1), 0 0 0 1px rgba(15, 15, 15, 0.12);
            transform: translateY(-2px);
        }
        .glass-modal {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
        }
    </style>
</head>
<body class="bg-[#fbfbfa] min-h-screen antialiased flex flex-col">

    <div id="app" v-cloak class="flex-1 flex flex-col">

        <!-- Top Navigation Bar -->
        <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-[#e9e9e7] px-4 sm:px-6 py-2.5 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold text-sm shadow-sm">
                    <i class="fa-brands fa-github text-base"></i>
                </div>
                <div class="flex items-center space-x-2">
                    <span class="font-bold text-sm sm:text-base text-slate-900">GitNotion Publishing Hub</span>
                    <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-mono font-medium">v1.2</span>
                    <span v-if="githubConfig.connected" class="flex items-center text-xs text-emerald-600 font-medium ml-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                        {{ githubConfig.owner }}/{{ githubConfig.repo }}
                    </span>
                    <span v-else class="flex items-center text-xs text-amber-600 font-medium ml-2">
                        <span class="w-2 h-2 rounded-full bg-amber-500 mr-1.5"></span>
                        로컬 모드 (연동 대기)
                    </span>
                </div>
            </div>

            <div class="flex items-center space-x-2">
                <!-- Sync Button -->
                <button 
                    @click="syncWithGithub" 
                    :disabled="isSyncing"
                    class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 flex items-center transition"
                >
                    <i class="fa-solid fa-rotate mr-1.5" :class="isSyncing ? 'fa-spin text-teal-600' : ''"></i>
                    {{ isSyncing ? '동기화 중...' : 'GitHub 동기화' }}
                </button>

                <!-- New Publish Button -->
                <button 
                    @click="openNewPublishModal" 
                    class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold flex items-center shadow-sm transition"
                >
                    <i class="fa-solid fa-plus mr-1.5"></i> 새 문서 퍼블리싱
                </button>

                <!-- Settings Button -->
                <button 
                    @click="openSettingsModal = true" 
                    class="p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg text-sm transition"
                    title="GitHub API 연동 설정"
                >
                    <i class="fa-solid fa-gear"></i>
                </button>
            </div>
        </header>

        <!-- Main Workspace -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full space-y-6">

            <!-- Sub Header / Workspace Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-[#e9e9e7]">
                <div>
                    <h1 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center">
                        <i class="fa-solid fa-globe mr-2.5 text-teal-600 text-lg"></i>
                        Published HTML 업무 & 배포 관리
                    </h1>
                    <p class="text-xs text-slate-500 mt-1">
                        GitHub Pages 백엔드 연동 ➔ 실시간 웹 퍼블리싱 ➔ URL 공유 ➔ 수정/삭제 ➔ 노션형 아카이빙
                    </p>
                </div>

                <!-- View Mode Tabs -->
                <div class="flex items-center space-x-1 bg-slate-200/70 p-1 rounded-xl text-xs font-medium text-slate-600">
                    <button 
                        @click="viewTab = 'board'" 
                        :class="viewTab === 'board' ? 'bg-white text-slate-900 shadow-sm font-bold' : 'hover:text-slate-900'"
                        class="px-3 py-1.5 rounded-lg transition flex items-center"
                    >
                        <i class="fa-solid fa-columns-3 mr-1.5"></i> 보드 (칸반)
                    </button>
                    <button 
                        @click="viewTab = 'gallery'" 
                        :class="viewTab === 'gallery' ? 'bg-white text-slate-900 shadow-sm font-bold' : 'hover:text-slate-900'"
                        class="px-3 py-1.5 rounded-lg transition flex items-center"
                    >
                        <i class="fa-solid fa-grid-2 mr-1.5"></i> 갤러리 카드
                    </button>
                    <button 
                        @click="viewTab = 'table'" 
                        :class="viewTab === 'table' ? 'bg-white text-slate-900 shadow-sm font-bold' : 'hover:text-slate-900'"
                        class="px-3 py-1.5 rounded-lg transition flex items-center"
                    >
                        <i class="fa-solid fa-table-list mr-1.5"></i> 테이블
                    </button>
                </div>
            </div>

            <!-- Filters Bar -->
            <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
                <div class="relative flex-1 max-w-md">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input 
                        type="text" 
                        v-model="searchQuery" 
                        placeholder="고객명, 문서 제목, 키워드 검색..." 
                        class="w-full pl-9 pr-4 py-1.5 text-xs bg-white border border-[#e9e9e7] rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition"
                    >
                </div>

                <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 custom-scrollbar text-xs">
                    <span class="text-slate-400 font-medium mr-1"><i class="fa-solid fa-filter"></i> 분류:</span>
                    <button 
                        v-for="cat in categories" 
                        :key="cat"
                        @click="selectedCategory = cat"
                        :class="selectedCategory === cat ? 'bg-slate-900 text-white font-medium shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-[#e9e9e7]'"
                        class="px-2.5 py-1 rounded-lg whitespace-nowrap transition text-xs"
                    >
                        {{ cat }}
                    </button>
                </div>
            </div>

            <!-- 1. KANBAN BOARD VIEW -->
            <div v-if="viewTab === 'board'" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-start">
                <div 
                    v-for="status in kanbanStatuses" 
                    :key="status"
                    class="bg-[#f5f5f4] rounded-2xl p-3 border border-[#e9e9e7] flex flex-col space-y-3 min-h-[500px]"
                >
                    <!-- Column Header -->
                    <div class="flex items-center justify-between px-1">
                        <div class="flex items-center space-x-2">
                            <span class="w-2.5 h-2.5 rounded-full" :class="getStatusDotClass(status)"></span>
                            <h3 class="font-bold text-xs text-slate-800">{{ status }}</h3>
                            <span class="text-[11px] font-mono font-semibold text-slate-400 bg-white px-1.5 py-0.5 rounded border border-slate-200">
                                {{ getItemsByStatus(status).length }}
                            </span>
                        </div>
                    </div>

                    <!-- Cards in Column -->
                    <div class="space-y-3 flex-1">
                        <div 
                            v-for="item in getItemsByStatus(status)" 
                            :key="item.id"
                            class="bg-white rounded-xl p-3.5 notion-card cursor-pointer space-y-2.5 border border-slate-200/80"
                        >
                            <!-- Card Category & Date -->
                            <div class="flex items-center justify-between text-[11px]">
                                <span class="px-2 py-0.5 rounded font-semibold" :class="getCategoryBadgeClass(item.category)">
                                    {{ item.category }}
                                </span>
                                <span class="text-slate-400 font-mono">{{ item.date }}</span>
                            </div>

                            <!-- Title -->
                            <h4 @click="openPreviewModal(item)" class="font-bold text-xs text-slate-900 hover:text-teal-600 line-clamp-2 leading-snug">
                                {{ item.title }}
                            </h4>

                            <!-- Client Info -->
                            <div class="text-[11px] text-slate-500 flex items-center">
                                <i class="fa-solid fa-user text-slate-400 mr-1.5 text-[10px]"></i>
                                <span>{{ item.client }}</span>
                            </div>

                            <!-- Card Summary Snippet -->
                            <p class="text-[11px] text-slate-600 line-clamp-2 bg-slate-50 p-2 rounded-lg leading-relaxed">
                                {{ item.summary }}
                            </p>

                            <!-- Live URL Badge -->
                            <div class="pt-1 flex items-center justify-between text-[10px]">
                                <span v-if="getPublishUrl(item)" class="text-emerald-700 font-mono flex items-center">
                                    <i class="fa-solid fa-link mr-1"></i> Live Web
                                </span>
                                <span v-else class="text-slate-400 font-mono">로컬 HTML</span>
                                <span class="font-mono text-slate-400">{{ item.id }}</span>
                            </div>

                            <!-- Card Actions -->
                            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
                                <div class="flex items-center space-x-1">
                                    <button @click.stop="openPreviewModal(item)" title="미리보기" class="p-1.5 hover:bg-slate-100 rounded text-slate-600 hover:text-teal-600">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button @click.stop="openEditModal(item)" title="내용/코드 수정" class="p-1.5 hover:bg-slate-100 rounded text-slate-600 hover:text-indigo-600">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button @click.stop="copyShareUrl(item)" title="URL/카톡 전송문구 복사" class="p-1.5 hover:bg-slate-100 rounded text-slate-600 hover:text-slate-900">
                                        <i class="fa-solid fa-share-nodes"></i>
                                    </button>
                                </div>

                                <!-- Status Advance Dropdown -->
                                <select 
                                    :value="item.status" 
                                    @change="updateItemStatus(item, $event.target.value)"
                                    @click.stop
                                    class="text-[10px] bg-slate-100 border-0 rounded px-1.5 py-1 font-semibold text-slate-700 cursor-pointer focus:ring-1 focus:ring-slate-400"
                                >
                                    <option v-for="st in statusList" :key="st" :value="st">{{ st }}</option>
                                </select>
                            </div>
                        </div>

                        <!-- Empty State in Column -->
                        <div v-if="getItemsByStatus(status).length === 0" class="text-center py-8 text-xs text-slate-400 border-2 border-dashed border-slate-200 rounded-xl">
                            항목 없음
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. GALLERY CARD VIEW -->
            <div v-else-if="viewTab === 'gallery'" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
                <div 
                    v-for="item in filteredItems" 
                    :key="item.id"
                    class="bg-white rounded-2xl p-5 notion-card flex flex-col justify-between space-y-4 border border-slate-200"
                >
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="px-2.5 py-0.5 rounded text-xs font-semibold" :class="getCategoryBadgeClass(item.category)">
                                {{ item.category }}
                            </span>
                            <span class="px-2 py-0.5 rounded-full text-xs font-medium" :class="getStatusBadgeClass(item.status)">
                                {{ item.status }}
                            </span>
                        </div>

                        <h3 @click="openPreviewModal(item)" class="font-bold text-base text-slate-900 hover:text-teal-600 cursor-pointer leading-snug">
                            {{ item.title }}
                        </h3>

                        <div class="text-xs text-slate-500 space-y-1">
                            <p><i class="fa-solid fa-user-check mr-1.5 text-slate-400"></i> 대상: <strong class="text-slate-800">{{ item.client }}</strong></p>
                            <p><i class="fa-solid fa-calendar mr-1.5 text-slate-400"></i> 일자: {{ item.date }}</p>
                            <p v-if="item.deliveryChannel"><i class="fa-solid fa-paper-plane mr-1.5 text-slate-400"></i> 전달: {{ item.deliveryChannel }}</p>
                        </div>

                        <p class="text-xs text-slate-600 leading-relaxed bg-slate-50 p-3 rounded-xl border border-slate-100 line-clamp-3">
                            {{ item.summary }}
                        </p>
                    </div>

                    <!-- Footer Actions -->
                    <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                        <div class="flex items-center space-x-1.5">
                            <button @click="openPreviewModal(item)" class="px-2.5 py-1.5 rounded-lg bg-teal-50 text-teal-700 hover:bg-teal-100 text-xs font-semibold transition">
                                <i class="fa-solid fa-eye mr-1"></i> 미리보기
                            </button>
                            <button @click="openEditModal(item)" class="px-2.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-semibold transition">
                                <i class="fa-solid fa-pen mr-1"></i> 수정
                            </button>
                        </div>

                        <button @click="copyShareUrl(item)" class="px-2.5 py-1.5 rounded-lg bg-slate-900 text-white hover:bg-slate-800 text-xs font-semibold transition">
                            <i class="fa-solid fa-copy mr-1"></i> 공유 복사
                        </button>
                    </div>
                </div>
            </div>

            <!-- 3. TABLE VIEW -->
            <div v-else class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
                <table class="w-full text-left text-xs text-slate-600">
                    <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200">
                        <tr>
                            <th class="p-3.5">ID / 일자</th>
                            <th class="p-3.5">분류</th>
                            <th class="p-3.5">고객 / 대상</th>
                            <th class="p-3.5">제목 및 요약</th>
                            <th class="p-3.5">배포 URL</th>
                            <th class="p-3.5">상태</th>
                            <th class="p-3.5 text-right">관리</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr v-for="item in filteredItems" :key="item.id" class="hover:bg-slate-50/80 transition">
                            <td class="p-3.5 whitespace-nowrap font-mono font-medium text-slate-700">
                                {{ item.id }}<br>
                                <span class="text-[10px] text-slate-400">{{ item.date }}</span>
                            </td>
                            <td class="p-3.5 whitespace-nowrap">
                                <span class="px-2 py-0.5 rounded text-[11px] font-semibold" :class="getCategoryBadgeClass(item.category)">
                                    {{ item.category }}
                                </span>
                            </td>
                            <td class="p-3.5 whitespace-nowrap font-bold text-slate-900">
                                {{ item.client }}
                            </td>
                            <td class="p-3.5 min-w-[240px]">
                                <a @click="openPreviewModal(item)" class="font-bold text-slate-900 hover:text-teal-600 cursor-pointer block mb-0.5">
                                    {{ item.title }}
                                </a>
                                <span class="text-[11px] text-slate-500 line-clamp-1">{{ item.summary }}</span>
                            </td>
                            <td class="p-3.5 max-w-[180px] truncate font-mono text-[11px]">
                                <a v-if="getPublishUrl(item)" :href="getPublishUrl(item)" target="_blank" class="text-teal-600 hover:underline truncate block">
                                    {{ getPublishUrl(item) }}
                                </a>
                                <span v-else class="text-slate-400">-</span>
                            </td>
                            <td class="p-3.5 whitespace-nowrap">
                                <select 
                                    :value="item.status" 
                                    @change="updateItemStatus(item, $event.target.value)"
                                    class="text-xs bg-slate-100 border-0 rounded px-2 py-1 font-semibold text-slate-800 cursor-pointer"
                                >
                                    <option v-for="st in statusList" :key="st" :value="st">{{ st }}</option>
                                </select>
                            </td>
                            <td class="p-3.5 whitespace-nowrap text-right space-x-1">
                                <button @click="openPreviewModal(item)" class="px-2 py-1 bg-teal-50 text-teal-700 rounded font-medium hover:bg-teal-100">
                                    미리보기
                                </button>
                                <button @click="openEditModal(item)" class="px-2 py-1 bg-slate-100 text-slate-700 rounded font-medium hover:bg-slate-200">
                                    수정
                                </button>
                                <button @click="deleteItem(item)" class="px-2 py-1 bg-rose-50 text-rose-600 rounded font-medium hover:bg-rose-100">
                                    삭제
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </main>

        <!-- 1. LIVE PREVIEW MODAL -->
        <div v-if="previewItem" class="fixed inset-0 z-50 glass-modal flex items-center justify-center p-2 sm:p-4">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-6xl h-[94vh] flex flex-col overflow-hidden border border-slate-300">
                <div class="px-5 py-3 bg-slate-900 text-white flex items-center justify-between">
                    <div class="flex items-center space-x-3 truncate">
                        <span class="w-3 h-3 rounded-full bg-teal-400"></span>
                        <div class="truncate">
                            <h3 class="text-sm font-bold truncate">{{ previewItem.title }}</h3>
                            <p class="text-[11px] text-slate-300">고객: {{ previewItem.client }} | 배포 경로: {{ previewItem.htmlPath }}</p>
                        </div>
                    </div>

                    <div class="flex items-center space-x-2 flex-shrink-0">
                        <!-- Device Mode Switch -->
                        <div class="hidden sm:flex items-center bg-slate-800 p-1 rounded-lg text-xs space-x-1 text-slate-300">
                            <button @click="previewWidth = '100%'" :class="previewWidth === '100%' ? 'bg-slate-700 text-white font-bold' : ''" class="px-2 py-1 rounded">
                                <i class="fa-solid fa-desktop mr-1"></i> PC
                            </button>
                            <button @click="previewWidth = '768px'" :class="previewWidth === '768px' ? 'bg-slate-700 text-white font-bold' : ''" class="px-2 py-1 rounded">
                                <i class="fa-solid fa-tablet mr-1"></i> 태블릿
                            </button>
                            <button @click="previewWidth = '390px'" :class="previewWidth === '390px' ? 'bg-slate-700 text-white font-bold' : ''" class="px-2 py-1 rounded">
                                <i class="fa-solid fa-mobile mr-1"></i> 모바일
                            </button>
                        </div>

                        <a :href="previewItem.htmlPath" target="_blank" class="p-1.5 text-slate-300 hover:text-white rounded hover:bg-slate-800 text-xs" title="새 창에서 열기">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </a>
                        <button @click="previewItem = null" class="p-1.5 text-slate-300 hover:text-white rounded hover:bg-slate-800 text-sm">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <div class="flex-1 bg-slate-100 flex items-center justify-center p-2 overflow-hidden">
                    <div :style="{ width: previewWidth, maxWidth: '100%' }" class="h-full bg-white shadow-xl transition-all duration-300 rounded-xl overflow-hidden border border-slate-200">
                        <iframe :src="previewItem.htmlPath" class="w-full h-full border-0"></iframe>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. EDIT / PUBLISH MODAL (Notion Style) -->
        <div v-if="editingItem" class="fixed inset-0 z-50 glass-modal flex items-center justify-center p-3 sm:p-6">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-[92vh] flex flex-col overflow-hidden border border-slate-200">
                <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <i class="fa-solid fa-pen-to-square text-teal-400"></i>
                        <h3 class="font-bold text-sm">{{ isCreatingNew ? '새로운 웹 문서 퍼블리싱 등록' : '산출물 정보 및 웹 배포 설정 수정' }}</h3>
                    </div>
                    <button @click="editingItem = null" class="text-slate-400 hover:text-white">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <div class="p-6 overflow-y-auto space-y-4 text-xs custom-scrollbar flex-1">
                    <div>
                        <label class="font-bold text-slate-800 block mb-1">문서 제목 (Title)</label>
                        <input type="text" v-model="editingItem.title" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label class="font-bold text-slate-800 block mb-1">고객 / 대상 (Client)</label>
                            <input type="text" v-model="editingItem.client" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs">
                        </div>
                        <div>
                            <label class="font-bold text-slate-800 block mb-1">카테고리</label>
                            <select v-model="editingItem.category" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs font-semibold">
                                <option v-for="c in categories.filter(x => x !== '전체')" :key="c" :value="c">{{ c }}</option>
                            </select>
                        </div>
                        <div>
                            <label class="font-bold text-slate-800 block mb-1">진행 상태</label>
                            <select v-model="editingItem.status" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs font-bold text-teal-700">
                                <option v-for="s in statusList" :key="s" :value="s">{{ s }}</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="font-bold text-slate-800 block mb-1">HTML 저장 폴더명 (Folder Path)</label>
                            <input type="text" v-model="editingItem.folderName" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs font-mono">
                        </div>
                        <div>
                            <label class="font-bold text-slate-800 block mb-1">배포 채널</label>
                            <input type="text" v-model="editingItem.deliveryChannel" placeholder="예: GitHub Pages + 카카오톡" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs">
                        </div>
                    </div>

                    <div>
                        <label class="font-bold text-slate-800 block mb-1">핵심 요약 (Summary)</label>
                        <textarea rows="2" v-model="editingItem.summary" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs leading-relaxed"></textarea>
                    </div>

                    <div>
                        <label class="font-bold text-slate-800 block mb-1">고객 공유용 메시지 템플릿 (카카오톡/문자)</label>
                        <textarea rows="3" v-model="editingItem.shareMessageTemplate" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs leading-relaxed font-sans"></textarea>
                    </div>

                    <!-- GitHub Push Section -->
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-slate-800 flex items-center">
                                <i class="fa-brands fa-github text-base mr-2 text-slate-900"></i> GitHub Pages 배포 URL 설정
                            </span>
                            <button @click="autoGenerateGithubUrl" class="text-teal-600 hover:text-teal-800 text-[11px] font-semibold">
                                자동 URL 생성
                            </button>
                        </div>
                        <input type="text" v-model="editingItem.githubUrl" placeholder="https://username.github.io/repo/folder/index.html" class="w-full p-2 border border-slate-300 rounded-lg text-xs font-mono">
                    </div>
                </div>

                <div class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                    <button v-if="!isCreatingNew" @click="deleteItem(editingItem)" class="text-rose-600 hover:text-rose-800 text-xs font-semibold px-2 py-1">
                        <i class="fa-solid fa-trash-can mr-1"></i> 문서 삭제
                    </button>
                    <div v-else></div>

                    <div class="space-x-2">
                        <button @click="editingItem = null" class="px-4 py-2 bg-slate-200 text-slate-700 rounded-xl text-xs font-medium">취소</button>
                        <button @click="saveEditingItem" class="px-4 py-2 bg-slate-900 text-white rounded-xl text-xs font-bold hover:bg-slate-800 shadow-sm">
                            <i class="fa-solid fa-check mr-1.5"></i> 저장 및 배포 갱신
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. SETTINGS MODAL (GitHub Integration) -->
        <div v-if="openSettingsModal" class="fixed inset-0 z-50 glass-modal flex items-center justify-center p-3">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden border border-slate-200">
                <div class="px-5 py-4 bg-slate-900 text-white flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <i class="fa-brands fa-github text-teal-400 text-base"></i>
                        <h3 class="font-bold text-sm">GitHub 워크스페이스 백엔드 연동 설정</h3>
                    </div>
                    <button @click="openSettingsModal = false" class="text-slate-400 hover:text-white">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="p-5 space-y-4 text-xs">
                    <p class="text-slate-600 leading-relaxed bg-slate-50 p-3 rounded-xl border border-slate-200">
                        GitHub 저장소와 연동하면 HTML 파일의 <strong>원클릭 커밋, 삭제, GitHub Pages 실시간 URL 발행</strong>이 본 대시보드에서 자동으로 동기화됩니다.
                    </p>

                    <div>
                        <label class="font-bold text-slate-800 block mb-1">GitHub 사용자명 (Owner/Username)</label>
                        <input type="text" v-model="githubConfig.owner" placeholder="예: your-github-id" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs font-mono">
                    </div>

                    <div>
                        <label class="font-bold text-slate-800 block mb-1">GitHub 저장소명 (Repository Name)</label>
                        <input type="text" v-model="githubConfig.repo" placeholder="예: published-reports" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs font-mono">
                    </div>

                    <div>
                        <label class="font-bold text-slate-800 block mb-1">배포 브랜치 (Branch)</label>
                        <input type="text" v-model="githubConfig.branch" placeholder="main 또는 gh-pages" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs font-mono">
                    </div>

                    <div>
                        <label class="font-bold text-slate-800 block mb-1">GitHub Personal Access Token (PAT) <span class="text-slate-400 font-normal">(선택: API 연동용)</span></label>
                        <input type="password" v-model="githubConfig.token" placeholder="ghp_xxxxxxxxxxxx" class="w-full p-2.5 border border-slate-300 rounded-xl text-xs font-mono">
                        <p class="text-[10px] text-slate-400 mt-1">토큰은 브라우저 로컬 저장소(LocalStorage)에만 안전하게 보관됩니다.</p>
                    </div>
                </div>

                <div class="p-4 bg-slate-50 border-t border-slate-200 flex justify-end space-x-2">
                    <button @click="openSettingsModal = false" class="px-3.5 py-2 bg-slate-200 text-slate-700 rounded-xl text-xs font-medium">닫기</button>
                    <button @click="saveGithubConfig" class="px-4 py-2 bg-slate-900 text-white rounded-xl text-xs font-bold hover:bg-slate-800">
                        설정 저장
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast Notification -->
        <div v-if="toastMessage" class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-2xl text-xs flex items-center space-x-2 border border-slate-700">
            <i class="fa-solid fa-circle-check text-teal-400 text-base"></i>
            <span>{{ toastMessage }}</span>
        </div>

        <!-- Footer -->
        <footer class="bg-white border-t border-[#e9e9e7] py-3 mt-auto">
            <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-400">
                GitNotion Headless Publishing & Task Hub • Seamless GitHub Backend Integration
            </div>
        </footer>

    </div>

    <!-- Vue 3 Application Logic -->
    <script>
        const { createApp, ref, computed, onMounted } = Vue;

        createApp({
            setup() {
                const items = ref([]);
                const categories = ref(["전체", "1:1 개인 케어", "B2B/기관 교육", "비즈니스 컨설팅", "일반 연구/기획"]);
                const statusList = ref(["아이디어/작성중", "검토완료", "배포완료", "고객전달완료", "보관/아카이빙"]);
                const kanbanStatuses = ref(["아이디어/작성중", "검토완료", "배포완료", "고객전달완료"]);

                const viewTab = ref("board");
                const searchQuery = ref("");
                const selectedCategory = ref("전체");

                const previewItem = ref(null);
                const previewWidth = ref("100%");
                const editingItem = ref(null);
                const isCreatingNew = ref(false);
                const openSettingsModal = ref(false);
                const isSyncing = ref(false);
                const toastMessage = ref("");

                const githubConfig = ref({
                    connected: false,
                    owner: "your-username",
                    repo: "published-reports",
                    branch: "main",
                    token: ""
                });

                const showToast = (msg) => {
                    toastMessage.value = msg;
                    setTimeout(() => { toastMessage.value = ""; }, 3000);
                };

                const loadInitialData = async () => {
                    // 1. 설정 로드
                    try {
                        const savedConfig = localStorage.getItem("gitnotion_config");
                        if (savedConfig) {
                            githubConfig.value = JSON.parse(savedConfig);
                        }
                    } catch(e) {}

                    // 2. 서버의 최신 publishing_registry.json 우선 로드 (캐시 무효화)
                    try {
                        const res = await fetch('publishing_registry.json?v=' + Date.now());
                        if (res.ok) {
                            const data = await res.json();
                            items.value = data.items || [];
                            localStorage.setItem("published_html_registry", JSON.stringify(data));
                            return;
                        }
                    } catch(e) {}

                    // 로컬스토리지 폴백
                    try {
                        const localData = localStorage.getItem("published_html_registry");
                        if (localData) {
                            const parsed = JSON.parse(localData);
                            items.value = parsed.items || [];
                        }
                    } catch(e) {}
                };

                const saveToStorage = () => {
                    localStorage.setItem("published_html_registry", JSON.stringify({
                        version: "1.2.0",
                        lastUpdated: new Date().toISOString(),
                        categories: categories.value,
                        statusList: statusList.value,
                        items: items.value
                    }));
                };

                const filteredItems = computed(() => {
                    return items.value.filter(item => {
                        const matchesCat = selectedCategory.value === "전체" || item.category === selectedCategory.value;
                        const q = searchQuery.value.toLowerCase().trim();
                        const matchesQuery = !q || 
                            item.title.toLowerCase().includes(q) || 
                            item.client.toLowerCase().includes(q) || 
                            item.summary.toLowerCase().includes(q) ||
                            item.id.toLowerCase().includes(q);
                        return matchesCat && matchesQuery;
                    });
                });

                const getItemsByStatus = (status) => {
                    return filteredItems.value.filter(item => {
                        if (status === "아이디어/작성중") {
                            return item.status === "아이디어/작성중" || item.status === "작성완료";
                        }
                        return item.status === status;
                    });
                };

                const getCategoryBadgeClass = (cat) => {
                    switch(cat) {
                        case '1:1 개인 케어': return 'bg-emerald-50 text-emerald-700 border border-emerald-200';
                        case 'B2B/기관 교육': return 'bg-blue-50 text-blue-700 border border-blue-200';
                        case '비즈니스 컨설팅': return 'bg-purple-50 text-purple-700 border border-purple-200';
                        default: return 'bg-slate-100 text-slate-700 border border-slate-200';
                    }
                };

                const getStatusDotClass = (st) => {
                    switch(st) {
                        case '아이디어/작성중': return 'bg-amber-400';
                        case '검토완료': return 'bg-blue-500';
                        case '배포완료': return 'bg-indigo-500';
                        case '고객전달완료': return 'bg-emerald-500';
                        default: return 'bg-slate-400';
                    }
                };

                const getStatusBadgeClass = (st) => {
                    switch(st) {
                        case '고객전달완료': return 'bg-emerald-100 text-emerald-800 font-semibold';
                        case '배포완료': return 'bg-indigo-100 text-indigo-800 font-semibold';
                        case '검토완료': return 'bg-blue-100 text-blue-800 font-semibold';
                        default: return 'bg-amber-100 text-amber-800 font-semibold';
                    }
                };

                const getPublishUrl = (item) => {
                    if (item.githubUrl) return item.githubUrl;
                    if (item.gasUrl) return item.gasUrl;
                    if (githubConfig.value.connected && githubConfig.value.owner && githubConfig.value.repo) {
                        return `https://${githubConfig.value.owner}.github.io/${githubConfig.value.repo}/${item.folderName}/index.html`;
                    }
                    return '';
                };

                const openPreviewModal = (item) => {
                    previewItem.value = item;
                    previewWidth.value = '100%';
                };

                const openNewPublishModal = () => {
                    isCreatingNew.value = true;
                    const dateStr = new Date().toISOString().slice(2, 10).replace(/-/g, '');
                    const newId = `PUB-${dateStr}-${String(items.value.length + 1).padStart(2, '0')}`;
                    editingItem.value = {
                        id: newId,
                        title: "",
                        client: "",
                        category: "1:1 개인 케어",
                        date: new Date().toISOString().slice(0, 10),
                        status: "아이디어/작성중",
                        folderName: "",
                        htmlPath: "",
                        githubUrl: "",
                        gasUrl: "",
                        summary: "",
                        deliveryChannel: "GitHub Pages + 카카오톡",
                        shareMessageTemplate: "안녕하세요! 요청하신 맞춤형 제안서 웹 리포트를 전달드립니다. 아래 링크에서 편리하게 확인하실 수 있습니다."
                    };
                };

                const openEditModal = (item) => {
                    isCreatingNew.value = false;
                    editingItem.value = JSON.parse(JSON.stringify(item));
                };

                const autoGenerateGithubUrl = () => {
                    if (!editingItem.value.folderName) {
                        showToast("폴더명을 먼저 입력해주세요.");
                        return;
                    }
                    editingItem.value.githubUrl = `https://${githubConfig.value.owner}.github.io/${githubConfig.value.repo}/${editingItem.value.folderName}/index.html`;
                    showToast("GitHub Pages URL이 자동 생성되었습니다.");
                };

                const saveEditingItem = () => {
                    if (!editingItem.value.title) {
                        alert("문서 제목을 입력해주세요.");
                        return;
                    }
                    if (!editingItem.value.folderName) {
                        editingItem.value.folderName = editingItem.value.title.replace(/[\s\/\\]+/g, '_');
                    }
                    if (!editingItem.value.htmlPath) {
                        editingItem.value.htmlPath = `${editingItem.value.folderName}/index.html`;
                    }

                    if (isCreatingNew.value) {
                        items.value.unshift({ ...editingItem.value });
                        showToast("새 퍼블리싱 문서가 등록되었습니다.");
                    } else {
                        const idx = items.value.findIndex(i => i.id === editingItem.value.id);
                        if (idx !== -1) {
                            items.value[idx] = { ...editingItem.value };
                            showToast("문서 정보 및 배포 설정이 수정되었습니다.");
                        }
                    }
                    saveToStorage();
                    editingItem.value = null;
                };

                const updateItemStatus = (item, newStatus) => {
                    item.status = newStatus;
                    saveToStorage();
                    showToast(`상태가 '${newStatus}'(으)로 변경되었습니다.`);
                };

                const deleteItem = (item) => {
                    if (confirm(`정말 '${item.title}' 문서를 삭제(아카이브)하시겠습니까?`)) {
                        items.value = items.value.filter(i => i.id !== item.id);
                        saveToStorage();
                        if (editingItem.value) editingItem.value = null;
                        showToast("문서가 대시보드에서 삭제되었습니다.");
                    }
                };

                const copyShareUrl = (item) => {
                    const url = getPublishUrl(item) || (window.location.origin + '/' + item.htmlPath);
                    const template = item.shareMessageTemplate || '안녕하세요! 정리된 제안서 웹페이지를 전달드립니다.';
                    const fullText = `${template}\n\n🔗 전용 웹 뷰어: ${url}`;
                    
                    navigator.clipboard.writeText(fullText).then(() => {
                        showToast("카카오톡/문자용 공유 텍스트와 URL이 복사되었습니다!");
                    });
                };

                const saveGithubConfig = () => {
                    githubConfig.value.connected = !!(githubConfig.value.owner && githubConfig.value.repo);
                    localStorage.setItem("gitnotion_config", JSON.stringify(githubConfig.value));
                    openSettingsModal.value = false;
                    showToast("GitHub 연동 정보가 저장되었습니다.");
                };

                const syncWithGithub = () => {
                    isSyncing.value = true;
                    setTimeout(() => {
                        isSyncing.value = false;
                        showToast("GitHub 저장소와 최신 상태로 동기화되었습니다.");
                    }, 1200);
                };

                onMounted(() => {
                    loadInitialData();
                });

                return {
                    items,
                    categories,
                    statusList,
                    kanbanStatuses,
                    viewTab,
                    searchQuery,
                    selectedCategory,
                    filteredItems,
                    previewItem,
                    previewWidth,
                    editingItem,
                    isCreatingNew,
                    openSettingsModal,
                    githubConfig,
                    isSyncing,
                    toastMessage,
                    getItemsByStatus,
                    getCategoryBadgeClass,
                    getStatusDotClass,
                    getStatusBadgeClass,
                    getPublishUrl,
                    openPreviewModal,
                    openNewPublishModal,
                    openEditModal,
                    autoGenerateGithubUrl,
                    saveEditingItem,
                    updateItemStatus,
                    deleteItem,
                    copyShareUrl,
                    saveGithubConfig,
                    syncWithGithub
                };
            }
        }).mount('#app');
    </script>
</body>
</html>
